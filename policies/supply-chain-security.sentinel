import "tfconfig/v2" as tfconfig
import "strings"

# ---------------------------------------
# Policy: Supply Chain Security
# ---------------------------------------

# Providers must originate from trusted sources.
approved_provider_sources = ["registry.terraform.io/hashicorp/aws"]

# Require AWS provider to have a version constraint to avoid using untrusted versions.
required_provider_version_constraint = "~> 6."

# Trusted remote module source
approved_module_source = ["app.terraform.io/"]

# ---------------------------------------
# Provider collection
# ---------------------------------------

aws_providers = filter tfconfig.providers as _, provider {
	provider.name is "aws"
}

# ---------------------------------------
# Functions
# ---------------------------------------

# ---------------------------------------
# Rules
# ---------------------------------------


# Require AWS provider and approved source
approved_provider_sources_rule = rule {
	all aws_providers as _, provider {
		any approved_provider_sources as _, approved_source {
			strings.has_prefix(provider.full_name, approved_source)
		}
	}
}

# Require AWS provider to have a version constraint
aws_provider_version_constraint_rule = rule {
	all aws_providers as _, provider {
		provider.version_constraint is not null and strings.has_prefix(provider.version_constraint, required_provider_version_constraint)
	}
}

main = rule {
	approved_provider_sources_rule and aws_provider_version_constraint_rule
}
